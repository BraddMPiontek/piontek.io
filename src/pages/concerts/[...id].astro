---
import { getCollection, render } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';

export async function getStaticPaths() {
  const concerts = await getCollection('concerts', ({ data }) => !data.draft);
  return concerts.map((concert) => ({
    params: { id: concert.id },
    props: { concert, allConcerts: concerts },
  }));
}

const { concert, allConcerts } = Astro.props;
const { Content } = await render(concert);

const { headliner, headlinerUrl, support, venue, venueUrl, city, state, date, rating, relatedArtists, videos, coverImage, photos } = concert.data;
const artistNames = [headliner, ...(relatedArtists ?? [])];

function getYouTubeId(url: string): string {
  const match = url.match(/[?&]v=([^&]+)/);
  return match ? match[1] : '';
}

async function fetchYouTubeTitle(url: string): Promise<string | null> {
  try {
    const res = await fetch(`https://www.youtube.com/oembed?url=${encodeURIComponent(url)}&format=json`);
    if (!res.ok) return null;
    const data = await res.json();
    return data.title ?? null;
  } catch {
    return null;
  }
}

const videosWithTitles = videos
  ? await Promise.all(
      videos.map(async (v) => ({
        ...v,
        title: (await fetchYouTubeTitle(v.url)) ?? v.title,
      }))
    )
  : [];

const formattedDate = date.toLocaleDateString('en-US', {
  weekday: 'long',
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});

const relatedHeadlining = allConcerts
  .filter(c => artistNames.includes(c.data.headliner) && c.id !== concert.id)
  .sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf());

const relatedAsSupport = allConcerts
  .filter(c => c.id !== concert.id && c.data.support?.some(act => artistNames.includes(act.name)))
  .sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf());

const seenCount = relatedHeadlining.length + relatedAsSupport.length + 1;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={`${headliner} @ ${venue} | ${SITE_TITLE}`}
      description={`${headliner} at ${venue}, ${city}, ${state} on ${formattedDate}`}
    />
  </head>
  <body>
    <Header />
    <main data-pagefind-body>
      {coverImage && (
        <div class="hero-image">
          <img src={coverImage} alt={`${headliner} at ${venue}`} loading="lazy" />
        </div>
      )}

      <div class="concert-header">
        <a href="/concerts/" class="back">← All concerts</a>

        <h1>
          {headlinerUrl
            ? <a href={headlinerUrl} target="_blank" class="headliner-link">{headliner}</a>
            : headliner
          }
        </h1>

        {seenCount > 1 && (
          <p class="seen-count">Seen {seenCount} times</p>
        )}

        {support && support.length > 0 && (
          <p class="support">
            with {support.map((act, i) => (
              <>
                {act.url
                  ? <a href={act.url} target="_blank">{act.name}</a>
                  : act.name
                }
                {i < support.length - 1 ? ', ' : ''}
              </>
            ))}
          </p>
        )}

        <div class="meta-row">
          {venueUrl
            ? <a href={venueUrl} target="_blank" class="venue">{venue}</a>
            : <span class="venue">{venue}</span>
          }
          <span class="separator">·</span>
          <span class="location">{city}, {state}</span>
          <span class="separator">·</span>
          <span class="date">{formattedDate}</span>
        </div>

        {rating && (
          <div class="actions">
            <span class="rating">
              {Array.from({ length: 5 }, (_, i) => (
                <span class={i < rating ? 'star filled' : 'star'}>★</span>
              ))}
            </span>
          </div>
        )}
      </div>

      <div class="prose">
        <Content />
      </div>

      {videosWithTitles.length > 0 && (
        <div class="footage">
          <h3>Concert footage</h3>
          <div class="video-grid">
            {videosWithTitles.map(video => {
              const vid = getYouTubeId(video.url);
              return (
                <div class="video-facade" data-videoid={vid} data-title={video.title}>
                  <div class="thumb-wrap">
                    <img
                      src={`https://img.youtube.com/vi/${vid}/hqdefault.jpg`}
                      alt={video.title}
                      loading="lazy"
                    />
                    <button class="play-btn" aria-label={`Play ${video.title}`}>
                      <svg viewBox="0 0 24 24" width="48" height="48" aria-hidden="true">
                        <circle cx="12" cy="12" r="12" fill="rgba(0,0,0,0.6)" />
                        <path fill="white" d="M9.5 7.5l7 4.5-7 4.5V7.5z"/>
                      </svg>
                    </button>
                  </div>
                  <span class="video-title">{video.title}</span>
                </div>
              );
            })}
          </div>
        </div>
      )}

      {photos && photos.length > 0 && (
        <div class="photo-gallery">
          <h3>Photos</h3>
          <div class="photo-grid">
            {photos.map((photo, i) => (
              <button class="photo-thumb" data-index={i} aria-label={`Open photo ${i + 1}`}>
                <img src={photo} alt={`${headliner} at ${venue} — photo ${i + 1}`} loading="lazy" />
              </button>
            ))}
          </div>
        </div>
      )}

      {photos && photos.length > 0 && (
        <div class="lightbox" id="lightbox" aria-hidden="true">
          <button class="lightbox-close" aria-label="Close">&times;</button>
          <button class="lightbox-prev" aria-label="Previous">&#8249;</button>
          <button class="lightbox-next" aria-label="Next">&#8250;</button>
          <div class="lightbox-img-wrap">
            {photos.map((photo, i) => (
              <div class="lightbox-slide" data-index={i}>
                <img src={photo} alt={`${headliner} at ${venue} — photo ${i + 1}`} loading="lazy" />
              </div>
            ))}
          </div>
          <div class="lightbox-counter"></div>
        </div>
      )}

      {(relatedHeadlining.length > 0 || relatedAsSupport.length > 0) && (
        <div class="related-shows">
          <h3>Other {headliner} shows</h3>
          <ul>
            {relatedHeadlining.map(show => (
              <li>
                <a href={`/concerts/${show.id}/`}>
                  <span class="related-date">
                    {show.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' })}
                  </span>
                  <span class="related-venue">{show.data.venue}, {show.data.city}</span>
                </a>
              </li>
            ))}
            {relatedAsSupport.map(show => (
              <li>
                <a href={`/concerts/${show.id}/`}>
                  <span class="related-date">
                    {show.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' })}
                  </span>
                  <span class="related-venue">{show.data.venue}, {show.data.city}</span>
                  <span class="related-role">opening for {show.data.headliner}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}
    </main>
    <Footer />
  </body>
</html>
<script>
  // Lightbox
  const lightbox = document.getElementById('lightbox');
  if (lightbox) {
    const slides = lightbox.querySelectorAll<HTMLElement>('.lightbox-slide');
    const counter = lightbox.querySelector<HTMLElement>('.lightbox-counter');
    let current = 0;

    function show(index: number) {
      slides.forEach(s => s.classList.remove('active'));
      current = (index + slides.length) % slides.length;
      slides[current].classList.add('active');
      if (counter) counter.textContent = `${current + 1} / ${slides.length}`;
    }

    document.querySelectorAll<HTMLElement>('.photo-thumb').forEach(btn => {
      btn.addEventListener('click', () => {
        show(Number(btn.dataset.index));
        lightbox.setAttribute('aria-hidden', 'false');
        lightbox.classList.add('open');
        document.body.style.overflow = 'hidden';
      });
    });

    lightbox.querySelector('.lightbox-close')?.addEventListener('click', () => {
      lightbox.classList.remove('open');
      lightbox.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    });
    lightbox.querySelector('.lightbox-prev')?.addEventListener('click', () => show(current - 1));
    lightbox.querySelector('.lightbox-next')?.addEventListener('click', () => show(current + 1));

    lightbox.addEventListener('click', (e) => {
      if (e.target === lightbox) {
        lightbox.classList.remove('open');
        lightbox.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
      }
    });

    document.addEventListener('keydown', (e) => {
      if (!lightbox.classList.contains('open')) return;
      if (e.key === 'ArrowLeft') show(current - 1);
      if (e.key === 'ArrowRight') show(current + 1);
      if (e.key === 'Escape') {
        lightbox.classList.remove('open');
        lightbox.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
      }
    });
  }

  document.querySelectorAll<HTMLElement>('.video-facade').forEach(facade => {
    facade.addEventListener('click', () => {
      const vid = facade.dataset.videoid;
      if (!vid) return;
      const wrap = facade.querySelector('.thumb-wrap')!;
      wrap.innerHTML = `<iframe src="https://www.youtube.com/embed/${vid}?autoplay=1" allow="autoplay; encrypted-media" allowfullscreen></iframe>`;
      facade.style.cursor = 'default';
    });
  });
</script>
<style>
  .concert-header {
    padding: 2em 0;
    border-bottom: 1px solid var(--border);
    margin-bottom: 2em;
  }
  .back {
    display: inline-block;
    margin-bottom: 1.5em;
    color: var(--accent-secondary);
    font-size: 0.9em;
    text-shadow: none;
  }
  h1 {
    margin-bottom: 0.2em;
  }
  .headliner-link {
    background: linear-gradient(90deg, var(--accent), var(--accent-purple));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    text-decoration: none;
  }
  .headliner-link:hover {
    text-shadow: none;
    opacity: 0.8;
  }
  .seen-count {
    display: inline-block;
    font-size: 0.78em;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent-secondary);
    background: rgba(0, 229, 255, 0.08);
    border: 1px solid rgba(0, 229, 255, 0.25);
    border-radius: 999px;
    padding: 0.2em 0.8em;
    margin: 0.4em 0 0.75em;
  }
  .support {
    color: var(--text-muted);
    font-size: 1.1em;
    margin: 0 0 1em;
  }
  .support a {
    color: var(--accent-secondary);
    text-decoration: none;
  }
  .support a:hover {
    text-decoration: underline;
    text-shadow: none;
  }
  .meta-row {
    display: flex;
    align-items: center;
    gap: 0.75em;
    flex-wrap: wrap;
    margin-bottom: 1.5em;
  }
  .venue {
    color: var(--accent-secondary);
    font-weight: 600;
    text-decoration: none;
  }
  .venue:hover {
    text-decoration: underline;
    text-shadow: none;
  }
  .separator {
    color: var(--border);
  }
  .location, .date {
    color: var(--accent-secondary);
    opacity: 0.75;
    text-shadow: 0 0 6px rgba(0, 229, 255, 0.35);
  }
  .actions {
    display: flex;
    align-items: center;
    gap: 1em;
    flex-wrap: wrap;
  }
  .rating {
    display: flex;
    gap: 0.1em;
    font-size: 1.4em;
  }
  .star {
    color: var(--border);
  }
  .star.filled {
    color: var(--accent);
  }
  .prose {
    max-width: 720px;
  }
  .prose h2 {
    font-size: 1.1em;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--accent-secondary);
    text-shadow: 0 0 10px rgba(0, 229, 255, 0.5);
    border-bottom: 1px solid rgba(0, 229, 255, 0.2);
    padding-bottom: 0.3em;
    margin: 1.5em 0 0.5em;
  }
  .prose ol {
    padding-left: 0;
    list-style: none;
    counter-reset: setlist;
    display: flex;
    flex-direction: column;
    gap: 0.1em;
  }
  .prose ol li {
    counter-increment: setlist;
    display: flex;
    align-items: baseline;
    gap: 0.75em;
    padding: 0.2em 0;
    font-size: 0.95em;
    color: var(--text);
    border-bottom: 1px solid rgba(42, 42, 74, 0.5);
  }
  .prose ol li::before {
    content: counter(setlist);
    color: var(--accent);
    font-size: 0.72em;
    font-weight: 700;
    min-width: 1.8em;
    text-align: right;
    opacity: 0.7;
    flex-shrink: 0;
  }
  .prose ol li em {
    color: var(--accent-purple);
    font-style: italic;
    font-size: 0.88em;
    opacity: 0.85;
  }

  /* Concert footage */
  .footage {
    margin-top: 3em;
    padding-top: 2em;
    border-top: 1px solid var(--border);
    max-width: 720px;
  }
  .footage h3 {
    font-size: 0.8em;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--accent-secondary);
    text-shadow: 0 0 10px rgba(0, 229, 255, 0.55);
    margin: 0 0 1em;
    padding-bottom: 0.4em;
    border-bottom: 1px solid rgba(0, 229, 255, 0.2);
  }
  .video-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1em;
  }
  .video-facade {
    display: flex;
    flex-direction: column;
    gap: 0.4em;
    cursor: pointer;
  }
  .thumb-wrap {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: 6px;
    border: 1px solid var(--border);
    background: #000;
  }
  .thumb-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: opacity 0.2s ease;
  }
  .video-facade:hover .thumb-wrap img {
    opacity: 0.75;
  }
  .play-btn {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: none;
    border: none;
    cursor: pointer;
    transition: transform 0.15s ease;
  }
  .video-facade:hover .play-btn {
    transform: scale(1.1);
  }
  .play-btn svg circle {
    transition: fill 0.15s ease;
  }
  .video-facade:hover .play-btn svg circle {
    fill: rgba(255, 45, 120, 0.75);
  }
  .video-title {
    font-size: 0.85em;
    color: var(--text-muted);
    padding: 0 0.1em;
  }
  .thumb-wrap iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: none;
    border-radius: 6px;
  }

  /* Related shows */
  .related-shows {
    margin-top: 3em;
    padding-top: 2em;
    border-top: 1px solid var(--border);
    max-width: 720px;
  }
  .related-shows h3 {
    font-size: 0.8em;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--accent-secondary);
    text-shadow: 0 0 10px rgba(0, 229, 255, 0.55);
    margin: 0 0 1em;
    padding-bottom: 0.4em;
    border-bottom: 1px solid rgba(0, 229, 255, 0.2);
  }
  .related-shows ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4em;
  }
  .related-shows li a {
    display: flex;
    align-items: center;
    gap: 1em;
    padding: 0.6em 1em;
    background: linear-gradient(90deg, rgba(255, 45, 120, 0.04) 0%, var(--bg-surface) 40%);
    border: 1px solid var(--border);
    border-left: 2px solid var(--accent);
    border-radius: 6px;
    text-decoration: none;
    transition: all 0.2s ease;
  }
  .related-shows li a:hover {
    border-color: var(--accent);
    border-left-color: var(--accent);
    background: linear-gradient(90deg, rgba(255, 45, 120, 0.1) 0%, rgba(19, 19, 42, 0.9) 60%);
    box-shadow: 0 0 14px rgba(255, 45, 120, 0.25);
    text-shadow: none;
  }
  .related-date {
    color: var(--accent-secondary);
    font-size: 0.85em;
    white-space: nowrap;
    font-weight: 600;
  }
  .related-venue {
    color: var(--accent-purple);
    font-size: 0.85em;
    opacity: 0.85;
  }
  .related-role {
    color: var(--accent-secondary);
    font-size: 0.78em;
    font-style: italic;
    opacity: 0.6;
    margin-left: auto;
  }

  /* Hero image */
  .hero-image {
    width: 100%;
    max-height: 480px;
    overflow: hidden;
    margin-bottom: 2em;
    border-radius: 8px;
    border: 1px solid var(--border);
  }
  .hero-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Photo gallery */
  .photo-gallery {
    margin-top: 3em;
    padding-top: 2em;
    border-top: 1px solid var(--border);
    max-width: 720px;
  }
  .photo-gallery h3 {
    font-size: 0.8em;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--accent-secondary);
    text-shadow: 0 0 10px rgba(0, 229, 255, 0.55);
    margin: 0 0 1em;
    padding-bottom: 0.4em;
    border-bottom: 1px solid rgba(0, 229, 255, 0.2);
  }
  .photo-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 6px;
  }
  .photo-thumb {
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    overflow: hidden;
    border-radius: 4px;
    border: 1px solid var(--border);
    aspect-ratio: 4 / 3;
    display: block;
  }
  .photo-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }
  .photo-thumb:hover img {
    opacity: 0.8;
    transform: scale(1.03);
  }

  /* Lightbox */
  .lightbox {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.92);
    z-index: 1000;
    align-items: center;
    justify-content: center;
  }
  .lightbox.open {
    display: flex;
  }
  .lightbox-img-wrap {
    max-width: 90vw;
    max-height: 88vh;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .lightbox-slide {
    display: none;
  }
  .lightbox-slide.active {
    display: flex;
  }
  .lightbox-slide img {
    max-width: 90vw;
    max-height: 88vh;
    object-fit: contain;
    border-radius: 4px;
  }
  .lightbox-close,
  .lightbox-prev,
  .lightbox-next {
    position: fixed;
    background: rgba(0, 0, 0, 0.5);
    border: 1px solid rgba(255,255,255,0.15);
    color: #fff;
    cursor: pointer;
    border-radius: 50%;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.4em;
    transition: background 0.15s;
    z-index: 1001;
  }
  .lightbox-close:hover,
  .lightbox-prev:hover,
  .lightbox-next:hover {
    background: rgba(255, 45, 120, 0.6);
  }
  .lightbox-close { top: 1.2em; right: 1.2em; }
  .lightbox-prev  { left: 1.2em; top: 50%; transform: translateY(-50%); }
  .lightbox-next  { right: 1.2em; top: 50%; transform: translateY(-50%); }
  .lightbox-counter {
    position: fixed;
    bottom: 1.2em;
    left: 50%;
    transform: translateX(-50%);
    color: rgba(255,255,255,0.6);
    font-size: 0.85em;
    letter-spacing: 0.05em;
  }
</style>
